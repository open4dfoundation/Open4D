# Keep source distributions within the same lightweight boundary as the wheel.
include LICENSE
include README.md
include pyproject.toml
include open4d/data/catalog.json
recursive-include open4d/codecs/_backends/recipes *.json

prune open4d/codecs/draco/source
prune open4d/codecs/klt/source
prune open4d/codecs/n4mc/source
prune open4d/codecs/qndf/source
prune open4d/codecs/qndf_int8/source
prune open4d/codecs/vdmc/source
prune open4d/codecs/faster_vdmc/source
prune open4d/codecs/tvmc/source
prune open4d/codecs/tsmc/source
prune open4d/codecs/queen/source
prune open4d/codecs/3dgstream/source
prune open4d/codecs/rerf/source
prune open4d/codecs/vega/source
prune open4d/codecs/_adapters
prune open4d/reconstruction
prune scripts
prune .github
prune tests

recursive-exclude open4d/core/tests *
recursive-exclude open4d/data/tests *
recursive-exclude open4d/ml/tests *
recursive-exclude open4d/io/tests *
recursive-exclude open4d/torch_ops/tests *
recursive-exclude open4d/visualization/tests *
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store

include open4d/reconstruction/*.py
recursive-include open4d/reconstruction/rgbd *.py
recursive-exclude open4d/reconstruction/rgbd/tests *
prune open4d/reconstruction/rgbd/app
prune open4d/reconstruction/rgbd/src
prune open4d/reconstruction/rgbd/include
prune open4d/reconstruction/rgbd/python
prune open4d/reconstruction/rgbd/tools
recursive-exclude open4d/transport/tests *
