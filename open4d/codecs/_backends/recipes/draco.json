{
  "schema": "open4d.backend-recipe/v1",
  "name": "draco",
  "recipe_version": 1,
  "summary": "Build the pinned upstream Apache-2.0 Draco encoder and decoder in a separate backend store.",
  "mode": "build",
  "adapter": {
    "group": "open4d.codecs",
    "entry_points": [
      "draco"
    ],
    "distributions": [],
    "versions": ">=0.3,<0.4"
  },
  "license": {
    "ledger": ".github/THIRD_PARTY.md",
    "component": "open4d/codecs/draco/source",
    "decision": "EXCLUDED",
    "terms": "Apache-2.0",
    "restrictions": []
  },
  "components": {
    "draco": "source"
  },
  "profiles": {
    "macos": {
      "platform": {
        "system": "Darwin",
        "machine": [
          "arm64",
          "x86_64"
        ]
      },
      "unresolved": [],
      "commands": {
        "git": ">=2.20",
        "cmake": ">=3.17"
      },
      "sources": [
        {
          "id": "draco",
          "url": "https://github.com/google/draco.git",
          "commit": "47238930f698250f474163e1a29d77858aa5c158",
          "path": "source"
        }
      ],
      "steps": [
        {
          "name": "configure",
          "argv": [
            "cmake",
            "-S",
            "{root}/source",
            "-B",
            "{root}/source/build",
            "-DCMAKE_BUILD_TYPE=Release",
            "-DBUILD_TESTING=OFF",
            "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
          ]
        },
        {
          "name": "compile",
          "argv": [
            "cmake",
            "--build",
            "{root}/source/build",
            "--parallel",
            "{jobs}"
          ]
        }
      ],
      "outputs": [
        {
          "path": "source/build/draco_encoder",
          "executable": true
        },
        {
          "path": "source/build/draco_decoder",
          "executable": true
        }
      ],
      "register": {
        "tools": {
          "encoder": "{root}/source/build/draco_encoder",
          "decoder": "{root}/source/build/draco_decoder"
        }
      }
    },
    "linux": {
      "platform": {
        "system": "Linux",
        "machine": [
          "x86_64",
          "aarch64"
        ]
      },
      "unresolved": [],
      "commands": {
        "git": ">=2.20",
        "cmake": ">=3.17"
      },
      "sources": [
        {
          "id": "draco",
          "url": "https://github.com/google/draco.git",
          "commit": "47238930f698250f474163e1a29d77858aa5c158",
          "path": "source"
        }
      ],
      "steps": [
        {
          "name": "configure",
          "argv": [
            "cmake",
            "-S",
            "{root}/source",
            "-B",
            "{root}/source/build",
            "-DCMAKE_BUILD_TYPE=Release",
            "-DBUILD_TESTING=OFF",
            "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
          ]
        },
        {
          "name": "compile",
          "argv": [
            "cmake",
            "--build",
            "{root}/source/build",
            "--parallel",
            "{jobs}"
          ]
        }
      ],
      "outputs": [
        {
          "path": "source/build/draco_encoder",
          "executable": true
        },
        {
          "path": "source/build/draco_decoder",
          "executable": true
        }
      ],
      "register": {
        "tools": {
          "encoder": "{root}/source/build/draco_encoder",
          "decoder": "{root}/source/build/draco_decoder"
        }
      }
    }
  },
  "attach": {
    "components": {
      "draco": {
        "candidates": [
          ".",
          "open4d/codecs/draco/source",
          "draco"
        ],
        "markers": [
          "CMakeLists.txt"
        ]
      }
    }
  },
  "smoke": {
    "kind": "roundtrip",
    "codec": "draco-native"
  }
}
