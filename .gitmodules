[submodule "open4d/codecs/tvmc/draco"]
	path = open4d/codecs/tvmc/draco
	url = https://github.com/google/draco.git
[submodule "open4d/codecs/tsmc/draco"]
	path = open4d/codecs/tsmc/draco
	url = https://github.com/google/draco.git
[submodule "open4d/codecs/tsmc/third_party/sam3"]
	path = open4d/codecs/tsmc/third_party/sam3
	url = https://github.com/facebookresearch/sam3.git
[submodule "open4d/codecs/draco/draco"]
	path = open4d/codecs/draco/draco
	url = https://github.com/google/draco.git
[submodule "open4d/codecs/vdmc"]
	path = open4d/codecs/vdmc
	url = https://github.com/MPEGGroup/mpeg-vdmc-tm.git
# Pinned to v2.3.0, not to a newer release. `ssp_remesh/cmake/FindLIBIGL.cmake`
# ends with `include(libigl)` and the target links `igl::opengl_glfw`; libigl
# v2.4.0 rewrote its CMake so that including `cmake/libigl.cmake` directly is a
# FATAL_ERROR and renamed that target to `igl::glfw`. v2.3.0 is the last release
# the vendored build script speaks to.
[submodule "open4d/codecs/qndf/ssp_remesh/libigl"]
	path = open4d/codecs/qndf/ssp_remesh/libigl
	url = https://github.com/libigl/libigl.git
# The two Gaussian-splatting upstreams. Both are pinned, both are patched by
# gs_tools/scripts/setup.sh rather than edited in place, and QUEEN's NVIDIA
# License limits it and anything derived from it to non-commercial research or
# evaluation -- see gs_tools/THIRD_PARTY.md before redistributing either.
# Do not initialize these recursively: that pulls SIBR_viewers from
# gitlab.inria.fr, which nothing here builds. setup.sh initializes the one nested
# path that is needed.
[submodule "open4d/reconstruction/gs_tools/upstream/queen"]
	path = open4d/reconstruction/gs_tools/upstream/queen
	url = https://github.com/NVlabs/queen.git
[submodule "open4d/reconstruction/gs_tools/upstream/3dgstream"]
	path = open4d/reconstruction/gs_tools/upstream/3dgstream
	url = https://github.com/SJoJoK/3DGStream.git
