# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.conda/
conda-env/
.venv/
venv/
env/

# Editor / OS
.DS_Store
*.swp
*.swo

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local logs and process state
*.log
*.lock
*.pid

# Renders and containers written by the example scripts
examples/out/
examples/**/out/

# Benchmark dashboard runtime data
benchmark_app/data/
benchmark_app/outputs/
benchmark_app/runs/
benchmark_app/archives/

# Codec datasets, training runs, and generated reconstructions
# Existing tracked paper fixtures remain tracked; these rules prevent new local
# runs from silently expanding the source repository.
open4d/codecs/*/datasets/
open4d/codecs/*/outputs/
open4d/codecs/*/experiments/
open4d/codecs/*/checkpoints/
open4d/codecs/*/logs/
open4d/codecs/*/data/bench_*/
open4d/codecs/tvmc/arap-volume-tracking/data/*/
open4d/codecs/tsmc/arap-volume-tracking/data/*/

# Voxel-grid and point caches the ARAP volume tracker writes beside its input
# meshes on every run, which would otherwise show up as untracked additions
# inside a tracked dataset directory. Fixtures already committed are unaffected.
open4d/codecs/*/data/*/meshes/*vg_*.bin
open4d/codecs/*/data/*/meshes/*pc_*.bin

# Common generated model artifacts
*.ckpt
*.onnx
*.pt
*.pth
*.safetensors

# Basketball comparison app generated render assets (frames/videos/heatmaps)
basketball_comparison_app/assets/
basketball_comparison_app/outputs/

# QNDF-INT8 local setup symlinks (point into the sibling QNDF codec on this host)
open4d/codecs/qndf_int8/experiments
open4d/codecs/qndf_int8/objs_original

# Generated packaging metadata
*.egg-info/
