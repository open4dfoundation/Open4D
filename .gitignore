# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.conda/
conda-env/
.venv/
venv/
env/

# Editor / OS
.idea/
.DS_Store
*.swp
*.swo

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local logs and process state
*.log
*.lock
*.pid

# Renders and containers written by the example scripts
/open4d-demo/

# Benchmark dashboard runtime data
benchmark_app/data/
benchmark_app/outputs/
benchmark_app/runs/
benchmark_app/archives/

# Codec datasets, training runs, and generated reconstructions
# Existing tracked fixtures are unaffected.
4d_files/
open4d/codecs/*/source/datasets/
open4d/codecs/*/source/outputs/
open4d/codecs/*/source/experiments/
open4d/codecs/*/source/checkpoints/
open4d/codecs/*/source/logs/
open4d/codecs/*/source/data/bench_*/
open4d/codecs/tvmc/source/arap-volume-tracking/data/*/
open4d/codecs/tsmc/source/arap-volume-tracking/data/*/

# Reconstruction datasets and outputs
open4d/codecs/*/source/data/
open4d/codecs/*/source/datasets/
open4d/codecs/*/source/output/
open4d/codecs/*/source/outputs/
open4d/codecs/*/source/logs/
open4d/codecs/*/source/checkpoints/
# Submodules use their own ignore rules.

# ARAP volume tracker caches
open4d/codecs/*/source/data/*/meshes/*vg_*.bin
open4d/codecs/*/source/data/*/meshes/*pc_*.bin

# Common generated model artifacts
*.ckpt
*.onnx
*.pt
*.pth
*.safetensors
# 3DGStream's flame_steak scene requires these shipped weights.
!open4d/codecs/3dgstream/source/ntc/*.pth

# Basketball comparison app generated render assets (frames/videos/heatmaps)
basketball_comparison_app/assets/
basketball_comparison_app/outputs/

# QNDF-INT8 local setup symlinks (point into the sibling QNDF codec on this host)
open4d/codecs/qndf_int8/source/experiments
open4d/codecs/qndf_int8/source/objs_original
